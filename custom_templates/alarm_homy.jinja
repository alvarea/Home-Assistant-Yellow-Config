{#- ==========================================================================
    ALARM HOMY · Macros del motor de alarma
    Uso: {% from 'alarm_homy.jinja' import <macro> %}
    Las macros devuelven JSON (usar | from_json) salvo etiqueta_modo / nombres.
    Configuración por sensor = etiquetas (labels) en la UI:
      alarm_homy_ausente/casa/noche/vacaciones  -> modos en que está activo
      alarm_homy_inmediato     -> dispara sin retardo de entrada
      alarm_homy_armar_abierto -> permite armar abierto (se ignora hasta que cierre)
      (alarm_homy_auto_excluir eliminada el 2026-10-16: puertas y ventanas abiertas siempre bloquean el armado)
      (la etiqueta de exclusión del estudio se eliminó el 2026-10-21, ALA-31: ya no se excluye nada al armar;
       con actividad arriba el Noche se arma como "Casa nocturno", ver actividad_arriba y alarm_homy_auto.yaml)
      alarm_homy_unavailable   -> unavailable > 5 min cuenta como disparo SOLO en Ausente/Vacaciones
    Sin comunicación (unavailable/unknown > 2 min) con la alarma armada = AVERÍA:
      aviso (sensor.alarm_homy_averias), nunca impide armar. En Casa/Noche no dispara.
    Habilitado = input_boolean.alarm_homy_sensor_<object_id del sensor> != off
   ========================================================================== -#}

{%- macro etiqueta_modo(modo) -%}
{{ {'armed_away':'alarm_homy_ausente','armed_home':'alarm_homy_casa','armed_night':'alarm_homy_noche','armed_vacation':'alarm_homy_vacaciones'}.get(modo, '') }}
{%- endmacro -%}

{%- macro texto_modo(modo) -%}
{{ {'armed_away':'ausente','armed_home':'casa','armed_night':'noche','armed_vacation':'vacaciones'}.get(modo, '') }}
{%- endmacro -%}

{#- Sensores con etiqueta del modo y habilitados -#}
{%- macro sensores_modo(modo) -%}
{%- set ns = namespace(l=[]) -%}
{%- set lab = etiqueta_modo(modo) -%}
{%- if lab -%}
{%- for e in label_entities(lab) if e.startswith('binary_sensor.') and states('input_boolean.alarm_homy_sensor_' ~ e.split('.')[1]) != 'off' -%}
{%- set ns.l = ns.l + [e] -%}
{%- endfor -%}
{%- endif -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- Abiertos que IMPIDEN armar en el modo: TODAS las puertas y ventanas (desde 2026-10-12).
    Solo se salta la etiqueta alarm_homy_armar_abierto. Movimiento y vibración nunca bloquean. Unavailable = avería, no bloquea -#}
{%- macro bloqueantes(modo) -%}
{%- set ns = namespace(l=[]) -%}
{%- set permitidos = label_entities('alarm_homy_armar_abierto') -%}
{%- set unav = label_entities('alarm_homy_unavailable') -%}
{%- for e in sensores_modo(modo) | from_json if e not in permitidos
      and state_attr(e, 'device_class') not in ['motion', 'occupancy', 'presence', 'vibration', 'moving'] -%}
{%- if is_state(e, 'on') -%}
{%- set ns.l = ns.l + [e] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- ACTIVIDAD ARRIBA (2026-10-21, ALA-28) → JSON con los motivos legibles; [] = sin actividad.
    OR de: luces del área estudio_setup encendidas · binary_sensor.macbook_aac_active_2 on (unavailable no cuenta)
    · movimiento en la planta alta ahora o en los últimos <minutos> (uno por área).
    ALA-36 (23-10): lista EXPLÍCITA de sensores de movimiento de arriba (por área no vale: family_home_aac hereda
    el área Estudio_Sala del iPhone y la actividad no bajaba nunca). Un mmWave nuevo (ALA-26) se añade aquí.
    Cuenta un sensor si CAMBIÓ (on u off) en los últimos <minutos>: un on colgado no cuenta (23-10: el _ocupacion
    del Aqara quedó en on tras una recarga de ZHA). Con alguien arriba el Aqara de movimiento cicla cada ~70 s. -#}
{%- macro movimiento_arriba() -%}
{{ ['binary_sensor.aqara_movimiento_estudio', 'binary_sensor.aqara_movimiento_estudio_ocupacion',
    'binary_sensor.blink_estudio_motion'] | to_json }}
{%- endmacro -%}

{%- macro actividad_arriba(minutos=15) -%}
{%- set ns = namespace(l=[], luces=[]) -%}
{%- for e in area_entities('estudio_setup') | select('match', 'light\\.') | select('is_state', 'on') -%}
{%- set ns.luces = ns.luces + [(state_attr(e, 'friendly_name') or e) | regex_replace('(?i)^luz\\s+', '')] -%}
{%- endfor -%}
{%- if ns.luces | count > 2 -%}{%- set ns.l = ns.l + [ns.luces | count ~ ' luces de ' ~ area_name('estudio_setup')] -%}
{%- elif ns.luces | count > 0 -%}{%- set ns.l = ns.l + [('luz ' if ns.luces | count == 1 else 'luces ') ~ ns.luces | join(' y ')] -%}
{%- endif -%}
{%- if is_state('binary_sensor.macbook_aac_active_2', 'on') -%}{%- set ns.l = ns.l + ['MacBook activo'] -%}{%- endif -%}
{%- set mov = namespace(areas=[]) -%}
{%- for e in movimiento_arriba() | from_json if states[e] is not none -%}
{%- if states(e) in ['on', 'off'] and (as_timestamp(now()) - as_timestamp(states[e].last_changed)) < minutos * 60 -%}
{%- set mov.areas = mov.areas + [area_name(e) or 'planta alta'] -%}
{%- endif -%}
{%- endfor -%}
{%- for a in mov.areas | unique -%}{%- set ns.l = ns.l + ['movimiento ' ~ a] -%}{%- endfor -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- Sensores que han pasado a on DESPUÉS del último cambio de estado de la alarma.
    Unavailable > 5 min con etiqueta alarm_homy_unavailable: solo en Ausente/Vacaciones -#}
{%- macro activos() -%}
{%- set ns = namespace(l=[]) -%}
{%- set estado = states('input_select.alarm_homy_estado') -%}
{%- set modo = states('input_select.alarm_homy_modo') -%}
{%- if estado in ['armed_away','armed_home','armed_night','armed_vacation','pending','triggered'] and modo != 'disarmed' -%}
{%- set t0 = as_timestamp(states.input_select.alarm_homy_estado.last_changed) -%}
{%- set unav = label_entities('alarm_homy_unavailable') -%}
{%- for e in sensores_modo(modo) | from_json if states[e] is not none -%}
{%- set s = states[e] -%}
{%- set tc = as_timestamp(s.last_changed) -%}
{%- if s.state == 'on' and tc >= t0 -%}
{%- set ns.l = ns.l + [e] -%}
{%- elif modo in ['armed_away','armed_vacation'] and e in unav and s.state in ['unavailable','unknown'] and tc >= t0 and (as_timestamp(now()) - tc) > 300 -%}
{%- set ns.l = ns.l + [e] -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- Lista de entity_id -> "Nombre (Área)" separados por coma -#}
{%- macro nombres(lista) -%}
{%- set ns = namespace(l=[]) -%}
{%- for e in lista -%}
{%- set a = area_name(e) -%}
{%- set ns.l = ns.l + [(state_attr(e, 'friendly_name') or e) ~ (' (' ~ a ~ ')' if a else '')] -%}
{%- endfor -%}
{{ ns.l | join(', ') }}
{%- endmacro -%}

{#- Sensores del modo con su interruptor alarm_homy_sensor_* en OFF -#}
{%- macro deshabilitados(modo) -%}
{%- set ns = namespace(l=[]) -%}
{%- set lab = etiqueta_modo(modo) -%}
{%- if lab -%}
{%- for e in label_entities(lab) if e.startswith('binary_sensor.') and is_state('input_boolean.alarm_homy_sensor_' ~ e.split('.')[1], 'off') -%}
{%- set ns.l = ns.l + [e] -%}
{%- endfor -%}
{%- endif -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{%- macro nombre_modo(modo) -%}
{{ {'armed_away':'Ausente','armed_home':'Casa','armed_night':'Noche','armed_vacation':'Vacaciones','disarmed':'Desarmada'}.get(modo, modo) }}
{%- endmacro -%}

{%- macro nombres_voz(lista) -%}
{#- Para voz: "sensor <nombre>" sin área, sin marca (Aqara, IKEA, Hue, Blink) y sin repetir "sensor" -#}
{%- set ns = namespace(l=[]) -%}
{%- for e in lista if e -%}
{%- set n = (state_attr(e, 'friendly_name') or e) | regex_replace('(?i)^((aqara|ikea|hue|blink|sensor)\\s+)+', '') -%}
{%- set ns.l = ns.l + ['sensor ' ~ n] -%}
{%- endfor -%}
{{ (ns.l[:-1] | join(', ') ~ ' y ' ~ ns.l[-1]) if ns.l | count > 1 else (ns.l | join('')) }}
{%- endmacro -%}

{#- Perímetro (puertas/ventanas habilitadas del modo Ausente) abierto. Unavailable = avería (macro averias) -#}
{%- macro perimetro_abierto() -%}
{%- set ns = namespace(l=[]) -%}
{%- set unav = label_entities('alarm_homy_unavailable') -%}
{%- for e in sensores_modo('armed_away') | from_json
      if state_attr(e, 'device_class') in ['door', 'window', 'opening', 'garage_door'] -%}
{%- if is_state(e, 'on') -%}
{%- set ns.l = ns.l + [e] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- AVERÍAS: sensores habilitados de cualquier modo sin comunicación (unavailable/unknown) > 2 min -#}
{%- macro averias() -%}
{%- set ns = namespace(l=[]) -%}
{%- set todos = (label_entities('alarm_homy_ausente') + label_entities('alarm_homy_casa')
      + label_entities('alarm_homy_noche') + label_entities('alarm_homy_vacaciones')) | unique | sort -%}
{%- for e in todos if e.startswith('binary_sensor.') and states[e] is not none
      and states('input_boolean.alarm_homy_sensor_' ~ e.split('.')[1]) != 'off' -%}
{%- if states[e].state in ['unavailable', 'unknown'] and (as_timestamp(now()) - as_timestamp(states[e].last_changed)) > 120 -%}
{%- set ns.l = ns.l + [e] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.l | to_json }}
{%- endmacro -%}

{#- DETALLE de un sensor para el registro del disparo: "Nombre: abierta (on) desde las HH:MM:SS" -#}
{%- macro detalle(e) -%}
{%- if e == 'panico' -%}Pánico activado
{%- elif states[e] is none -%}{{ e }}: sin datos
{%- else -%}
{%- set s = states[e] -%}
{%- set dc = s.attributes.get('device_class') -%}
{%- set txt = 'sin comunicación (pila o cobertura)' if s.state in ['unavailable', 'unknown']
      else ({'door': 'abierta', 'window': 'abierta', 'opening': 'abierto', 'garage_door': 'abierta',
             'motion': 'movimiento detectado', 'moving': 'movimiento detectado', 'occupancy': 'presencia detectada',
             'presence': 'presencia detectada', 'vibration': 'vibración detectada'}.get(dc, 'activado') if s.state == 'on' else s.state) -%}
{{ s.name }}: {{ txt }} ({{ s.state }}) desde las {{ as_local(s.last_changed).strftime('%H:%M:%S') }}
{%- endif -%}
{%- endmacro -%}


{#- PRESENTES (2026-10-14): servicios notify de quien está en casa según binary_sensor.family_home_<x>
    (input_boolean.family_home_<x> AND person.<x> == home) -#}
{%- macro notify_presentes() -%}
{%- set m = {'binary_sensor.family_home_aac': 'notify.mobile_app_iphone_aac', 'binary_sensor.family_home_paf': 'notify.mobile_app_iphone_paf',
             'binary_sensor.family_home_aaf': 'notify.mobile_app_a2f', 'binary_sensor.family_home_mfc': 'notify.mobile_app_iphone_malen'} -%}
{{ m.items() | selectattr('0', 'is_state', 'on') | map(attribute='1') | list | to_json }}
{%- endmacro -%}


{#- BLINK (2026-10-16, ALA-25 fase 1): cámaras con detección activa en cada modo.
    En los modos que no aparecen, el sistema Blink queda desarmado. Al desarmar, las 9 vuelven a ON. -#}
{%- macro blink_todas() -%}
{{ ['puerta_principal', 'hall', 'piscina', 'cancela_left', 'cancela_right', 'porche', 'estudio', 'cocina', 'salon'] | to_json }}
{%- endmacro -%}

{%- macro blink_camaras(modo) -%}
{%- set todas = blink_todas() | from_json -%}
{#- Ausente: sin las cancelas (miran a la calle, pilas y WiFi débil; las cubren los sensores de presencia exteriores) -#}
{{ {'armed_away': ['puerta_principal', 'porche', 'piscina', 'hall', 'salon', 'cocina', 'estudio'],
    'armed_vacation': todas}.get(modo, []) | to_json }}
{%- endmacro -%}

{%- macro blink_nombre(cam) -%}
{{ {'puerta_principal': 'Puerta principal', 'hall': 'Hall', 'piscina': 'Piscina', 'cancela_left': 'Cancela izquierda',
    'cancela_right': 'Cancela derecha', 'porche': 'Porche', 'estudio': 'Estudio', 'cocina': 'Cocina', 'salon': 'Salón'}.get(cam, cam) }}
{%- endmacro -%}


{#- ==========================================================================
    VISTA "SENSORES ACTIVOS" (2026-10-16)
   ========================================================================== -#}
{#- Modo que muestra la vista: el armado actual, o el de vista previa (input_select.alarm_homy_modo_vista) si está desarmada -#}
{%- macro modo_vista() -%}
{%- set est = states('input_select.alarm_homy_estado') -%}
{%- set prev = {'Casa': 'armed_home', 'Noche': 'armed_night', 'Ausente': 'armed_away', 'Vacaciones': 'armed_vacation'} -%}
{{ states('input_select.alarm_homy_modo') if est in ['arming', 'armed_away', 'armed_home', 'armed_night', 'armed_vacation', 'pending', 'triggered']
   else prev.get(states('input_select.alarm_homy_modo_vista'), 'armed_away') }}
{%- endmacro -%}

{#- Situación real de un sensor en el modo de la vista → JSON {c: color, t: texto, i: icono}
    verde = vigilando en reposo · rojo = activo/abierto · ámbar = sin comunicación · gris = no participa -#}
{%- macro vigilancia(e) -%}
{%- set m = modo_vista() -%}
{%- set armada = states('input_select.alarm_homy_estado') not in ['disarmed', 'unknown', 'unavailable'] -%}
{%- set nm = nombre_modo(m) -%}
{%- set s = states(e) -%}
{%- set dc = state_attr(e, 'device_class') -%}
{%- set on = s == 'on' -%}
{%- set ico = {'door': ['mdi:door-closed', 'mdi:door-open'], 'garage_door': ['mdi:garage', 'mdi:garage-open'],
               'window': ['mdi:window-closed', 'mdi:window-open'], 'opening': ['mdi:window-closed-variant', 'mdi:window-open-variant'],
               'motion': ['mdi:motion-sensor-off', 'mdi:motion-sensor'], 'moving': ['mdi:motion-sensor-off', 'mdi:motion-sensor'],
               'occupancy': ['mdi:account-outline', 'mdi:account'], 'presence': ['mdi:account-outline', 'mdi:account'],
               'vibration': ['mdi:vibrate-off', 'mdi:vibrate']}.get(dc, ['mdi:checkbox-blank-circle-outline', 'mdi:checkbox-blank-circle']) -%}
{%- set txt_on = {'door': 'abierta', 'garage_door': 'abierta', 'window': 'abierta', 'opening': 'abierta', 'vibration': 'vibración'}.get(dc, 'detectando') -%}
{%- set txt_off = {'door': 'cerrada', 'garage_door': 'cerrada', 'window': 'cerrada', 'opening': 'cerrada', 'vibration': 'en reposo'}.get(dc, 'sin movimiento') -%}
{%- set en_modo = e in (sensores_modo(m) | from_json) -%}
{%- set etiquetado = e in label_entities(etiqueta_modo(m)) -%}
{%- set inm = e in label_entities('alarm_homy_inmediato') -%}
{%- set vig = 'Vigilando' if armada else 'Vigilará' -%}
{%- if not etiquetado -%}{%- set r = {'c': 'disabled', 't': 'No vigila en ' ~ nm, 'i': ico[1 if on else 0]} -%}
{%- elif not en_modo -%}{%- set r = {'c': 'disabled', 't': 'Deshabilitado', 'i': 'mdi:shield-off-outline'} -%}
{%- elif s in ['unavailable', 'unknown'] -%}{%- set r = {'c': 'amber', 't': 'Sin comunicación (avería)', 'i': 'mdi:access-point-network-off'} -%}
{%- elif on -%}{%- set r = {'c': 'red', 't': vig ~ ' · ' ~ txt_on ~ (' · impide armar' if not armada and dc in ['door', 'window', 'opening', 'garage_door'] else ''), 'i': ico[1]} -%}
{%- else -%}{%- set r = {'c': 'green', 't': vig ~ ' · ' ~ txt_off ~ (' · inmediato' if inm else ''), 'i': ico[0]} -%}
{%- endif -%}
{{ r | to_json }}
{%- endmacro -%}

{#- Cámara Blink en el modo de la vista → JSON {c, t, i} -#}
{%- macro vigilancia_blink(cam) -%}
{%- set m = modo_vista() -%}
{%- set armada = states('input_select.alarm_homy_estado') not in ['disarmed', 'unknown', 'unavailable'] -%}
{%- set mot = 'binary_sensor.blink_' ~ cam ~ '_motion' -%}
{%- set activa = cam in (blink_camaras(m) | from_json) -%}
{%- set dispara = mot in (sensores_modo(m) | from_json) -%}
{%- set blink_arm = not is_state('alarm_control_panel.blink_casa', 'disarmed') -%}
{%- if not activa -%}{%- set r = {'c': 'disabled', 't': 'Sin detección en ' ~ nombre_modo(m), 'i': 'mdi:cctv-off'} -%}
{%- elif states('camera.blink_' ~ cam) in ['unavailable', 'unknown'] -%}{%- set r = {'c': 'amber', 't': 'Sin comunicación', 'i': 'mdi:cctv-off'} -%}
{%- elif is_state(mot, 'on') -%}{%- set r = {'c': 'red', 't': 'Movimiento detectado', 'i': 'mdi:cctv'} -%}
{%- elif armada and not blink_arm -%}{%- set r = {'c': 'amber', 't': 'Sistema Blink sin armar', 'i': 'mdi:cctv'} -%}
{%- else -%}{%- set r = {'c': 'green', 't': ('Detectando' if armada else 'Detectará') ~ (' · dispara' if dispara else ' · solo aviso'), 'i': 'mdi:cctv'} -%}
{%- endif -%}
{{ r | to_json }}
{%- endmacro -%}

{#- Resumen de la vista: "Ausente (armada) · 24 vigilando · 2 activos · 0 sin comunicación" -#}
{%- macro resumen_vista() -%}
{%- set m = modo_vista() -%}
{%- set armada = states('input_select.alarm_homy_estado') not in ['disarmed', 'unknown', 'unavailable'] -%}
{%- set ns = namespace(v=0, a=0, o=0) -%}
{%- for e in sensores_modo(m) | from_json -%}
{%- set r = vigilancia(e) | from_json -%}
{%- if r.c == 'green' %}{% set ns.v = ns.v + 1 %}{% elif r.c == 'red' %}{% set ns.v = ns.v + 1 %}{% set ns.o = ns.o + 1 %}{% elif r.c == 'amber' %}{% set ns.a = ns.a + 1 %}{% endif -%}
{%- endfor -%}
{{ nombre_modo(m) }} ({{ 'armada' if armada else 'vista previa' }}) · {{ ns.v }} {{ 'vigilando' if armada else 'vigilarán' }} · {{ ns.o }} activos · {{ ns.a }} sin comunicación
{%- endmacro -%}
